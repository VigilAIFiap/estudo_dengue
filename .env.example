# Oracle (ETL/carga; também usada pela API quando DATA_SOURCE=oracle)
DB_USER=
DB_PASSWORD=
DB_DSN=
WALLET_DIR=
WALLET_PASSWORD=

# API analítica (api/main.py)
# DENGUE_DATA_DIR=dados/raw
DATA_SOURCE=csv
ORACLE_API_TABLE=PRATA
# Município usado na análise: "notificacao" (padrão, ID_MUNICIP: onde fica a unidade de saúde) ou
# "residencia" (ID_MN_RESI: onde o paciente mora). A residência exige a coluna ID_MN_RESI em todos
# os arquivos DENGBR23 a DENGBR26 (ou na tabela PRATA). Notificações sem residência válida usam o
# município de notificação. Reinicie a API depois de alterar.
# DENGUE_MUNICIPIO_BASE=residencia
API_CORS_ORIGINS=http://localhost:3000

# Formulário de acolhimento: habilite somente em ambiente controlado
TRIAGE_FORM_ENABLED=false
# Schema que contém VIGIL_TRIAGE_INTAKE e as tabelas de qualidade
VIGIL_DQ_SCHEMA=VIGIL_APEX
